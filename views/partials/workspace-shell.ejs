<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · Timesheet</title>
<script>try{var _t=localStorage.getItem("theme");if(_t)document.documentElement.dataset.theme=_t}catch(e){}</script>
<meta name="theme-color" content="#2563eb">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/assets/app.css">
<link rel="stylesheet" href="/assets/workspace.css">
</head>
<body data-initial-view="<%= initialView %>">
<header class="top"><div class="in"><div class="mh" role="img" aria-label="Logo Mạnh Hưng"></div><b class="brandname">Timesheet</b><span class="sp"></span><button id="bell" class="bell" title="Thông báo" aria-label="Thông báo" hidden>🔔<i id="bdg" hidden></i></button><button id="who" type="button" title="Hồ sơ cá nhân" aria-label="Hồ sơ cá nhân"></button><button id="out" hidden>Đăng xuất</button><div class="seg thm" role="group" aria-label="Giao diện"><button id="thl" title="Giao diện sáng">☀️<span>Sáng</span></button><button id="thd" title="Giao diện tối">🌙<span>Tối</span></button></div></div></header>
<main>
<div id="app"></div>
<div id="msg" role="status"></div>
</main>
<div id="npn" class="npn" hidden></div>
<div class="modal" id="prf" hidden><div class="card">
 <div class="row"><h2 style="margin:0">👤 Hồ sơ cá nhân</h2><span class="sp"></span><button id="prfx" type="button">Đóng</button></div>
 <div class="pavrow"><i class="av lg" id="pfav"></i>
  <div class="col"><div class="row"><label class="filebtn" for="pffile">📷 Chọn ảnh</label><input type="file" id="pffile" accept="image/*" hidden><button id="pfrm" type="button">Gỡ ảnh</button></div>
  <span class="mut">Ảnh sẽ được tự cắt vuông và nén nhỏ.</span></div></div>
 <div class="pfg">
  <label class="pfl">Tên hiển thị<input id="pfn" maxlength="60" autocomplete="name"></label>
  <label class="pfl">Số điện thoại<input id="pfp" type="tel" maxlength="20" autocomplete="tel" placeholder="VD: 0912 345 678"></label>
  <label class="pfl">Email<input id="pfe" type="email" maxlength="120" autocomplete="email"></label>
  <div class="mut" id="pfh"></div>
  <label class="pfl">Địa chỉ<input id="pfa" maxlength="200" autocomplete="street-address" placeholder="Số nhà, đường, quận/huyện, tỉnh/thành"></label>
 </div>
 <div class="pferr" id="pferr" role="alert"></div>
 <div class="row"><span class="sp"></span><button id="pfc" type="button">Huỷ</button><button class="p" id="pfs" type="button">Lưu hồ sơ</button></div>
</div></div>
<footer class="foot"><div class="in"><div class="mh" role="img" aria-label="Logo Mạnh Hưng"></div><div class="ft"><b>Công ty TNHH Phần mềm Mạnh Hưng</b><span>Timesheet – công cụ xếp lịch và tìm giờ rảnh chung cho nhóm</span></div></div></footer>
<script src="/api/config.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.js"></script>
<script src="/assets/workspace.js"></script>
</body>
</html>
