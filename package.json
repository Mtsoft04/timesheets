{
  "name": "timesheets-mvc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-client.mjs && tailwindcss -i ./src/styles/tailwind.css -o ./public/assets/app.css --minify",
    "predev": "npm run build",
    "dev": "node --watch server.js",
    "prestart": "npm run build",
    "start": "node server.js",
    "css:build": "tailwindcss -i ./src/styles/tailwind.css -o ./public/assets/app.css --minify"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "tailwindcss": "^4.1.13"
  }
}
